// Alt Cozy Games website: the static pages in site/ (generated by `npm run site` in the app
// repository) and a small Worker (src/worker.ts) for what static files cannot do: link
// previews for each duel and daily link, the App Link keys, short language-less paths and
// the first links' old addresses.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "altcozygames",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // Clean addresses: /pt/sudoku serves pt/sudoku/index.html, and /pt/sudoku/ redirects there.
    "html_handling": "drop-trailing-slash"
    // No not_found_handling: with "404-page", browser navigations that match no file get the
    // 404 page straight away and never reach the Worker (duel and daily links).
  },
  "workers_dev": true,
  // The domain is in this Cloudflare account: deploying creates its DNS record and certificate.
  "routes": [{ "pattern": "altcozygames.com", "custom_domain": true }]
}
